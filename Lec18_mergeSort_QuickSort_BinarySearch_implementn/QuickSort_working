
/*
 * ============================================================
 * QUICK SORT - RECURSION TREE WITH STEP BY STEP EXECUTION
 * ============================================================
 *
 * Problem Statement:
 * Sort the given array using the Quick Sort algorithm.
 *
 * Main Logic:
 * 1. Last element ko pivot element select karenge.
 * 2. Pivot se smaller ya equal elements ko left side rakhenge.
 * 3. Pivot se greater elements ko right side rakhenge.
 * 4. Pivot ko uski correct position par place karenge.
 * 5. Recursively left aur right parts ko sort karenge.
 
 condition
 // LEFT SIDE
quickSort(arr, low, pivotIndex - 1);

// RIGHT SIDE
quickSort(arr, pivotIndex + 1, high);

 *
 * Example:
 * Input:
 * [100, 70, 80, 10, 90, 20, 60, 50]
 *
 * Output:
 * [10, 20, 50, 60, 70, 80, 90, 100]
 *
 * Time Complexity:
 * Best Case: O(n log n)
 * Average Case: O(n log n)
 * Worst Case: O(n^2)
 *
 * ============================================================
 */

public class MainApp1QuickSort
{
    // ============================================================
    // Quick Sort Method
    // ============================================================

    static void quickSort(int[] arr, int low, int high)
    {
        // Base Condition
        if(low >= high)
        {
            return;
        }

        // Last element ko pivot banaya
        int pivotElement = arr[high];

        // Smaller elements ki next position
        int pivotIndex = low;

        // Pivot ko chhodkar baaki elements check karenge
        for(int i = low; i < high; i++)
        {
            if(arr[i] <= pivotElement)
            {
                // Swap arr[i] and arr[pivotIndex]
                int temp = arr[i];
                arr[i] = arr[pivotIndex];
                arr[pivotIndex] = temp;

                pivotIndex++;
            }
        }

        // Pivot ko uski correct position par rakhna
        int temp = arr[pivotIndex];
        arr[pivotIndex] = arr[high];
        arr[high] = temp;

        // Pivot ke left part ko sort karna
        quickSort(arr, low, pivotIndex - 1);

        // Pivot ke right part ko sort karna
        quickSort(arr, pivotIndex + 1, high);
    }

    // ============================================================
    // Main Method
    // ============================================================

    public static void main(String[] args)
    {
        int[] arr = {100, 70, 80, 10, 90, 20, 60, 50};

        quickSort(arr, 0, arr.length - 1);

        System.out.println("Sorted Array:");

        for(int no : arr)
        {
            System.out.print(no + " ");
        }
    }
}

